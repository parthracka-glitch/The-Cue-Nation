# ==============================================================================
# Cue Nation Parlour & Lounge - Environment Configuration
# NOTE: All values here are placeholders. Never commit live production secrets.
# ==============================================================================

# Supabase Public Keys (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Admin / Service Role (Server only, strictly never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cryptographic Token & Session Signing Key (HMAC SHA-256 / scrypt secret)
QR_SIGNING_KEY=generate_a_random_32_byte_secret_here

# Online Payment Gateway (Razorpay / Stripe Server Configuration)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
PAYMENT_WEBHOOK_SECRET=whsec_placeholder_webhook_signing_secret

# Edge Rate Limiting via Upstash Redis (Optional in local development)
UPSTASH_REDIS_REST_URL=https://your-upstash.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Venue Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Error Monitoring (Optional)
SENTRY_DSN=
